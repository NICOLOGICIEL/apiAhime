# ===================================================================
# Bascule dynamique DB selon APP_ENV (dans config/database.php) :
#   APP_ENV=production → connexion TiDB Cloud (variables TIDB_*)
#   APP_ENV=local      → connexion MySQL local/WAMP (variables DB_*)
# ===================================================================

# --- TiDB Cloud (production) — décommenter + définir APP_ENV=production ---
# TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_DATABASE=ahime
# TIDB_USERNAME=82uF9YAWVYqdK5L.root
# TIDB_PASSWORD=SQD3Xeykw55nLM22
# TIDB_SSL=true


# --- Base MySQL locale (WAMP) — APP_ENV=local ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ahime
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false

CACHE_DRIVER=redis
QUEUE_CONNECTION=sync

# Redis (cache des resultats de requetes SELECT de ApiController)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

# Nombre de r??sultats par page par d??faut pour les endpoints de recherche.
API_DEFAULT_PAGE_SIZE=30

# Cle d'acces au endpoint POST /api/action (header X-API-Key)
API_ACCESS_KEY=ad5b1b2afc3443c5839d6cde59d8090b

# Duree de vie (en secondes) du cache des resultats de requetes SQL (0 = desactive)
API_CACHE_TTL=60

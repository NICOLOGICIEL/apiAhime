{
    "name": "ahime/api",
    "description": "API REST (Lumen) de l'application Ahime : recherche d'hôtels, d'artisans et de compagnies de transport.",
    "keywords": ["lumen", "api", "ahime"],
    "type": "project",
    "require": {
        "php": "^8.1",
        "illuminate/redis": "10.0",
        "laravel/lumen-framework": "^10.0",
        "predis/predis": "2.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

APP_NAME=Ahime
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Base existante (import de c0ahi1745.sql), ne pas laisser Eloquent la migrer.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=c0ahi1745
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false

CACHE_DRIVER=redis
QUEUE_CONNECTION=sync

# Redis (cache des resultats de requetes SELECT de ApiController)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

# Nombre de résultats par page par défaut pour les endpoints de recherche.
API_DEFAULT_PAGE_SIZE=30

# Cle d'acces au endpoint POST /api/action (header X-API-Key)
API_ACCESS_KEY=

# Duree de vie (en secondes) du cache des resultats de requetes SQL (0 = desactive)
API_CACHE_TTL=60

APP_NAME=Ahime
APP_ENV=local
APP_KEY=base64:jARC20rPV4+obFhiYGucpeKVQCawhVr3WX4Dz5kXWgI=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=localhost/api

# Base MySQL locale (WAMP), sans TLS. A copier vers .env pour developper
# en local — voir README pour la config TiDB Cloud utilisee en production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ahime
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Nombre de résultats par page par défaut pour les endpoints de recherche.
API_DEFAULT_PAGE_SIZE=30
